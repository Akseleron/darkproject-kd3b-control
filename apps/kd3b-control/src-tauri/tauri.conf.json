{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KD3B Control",
  "version": "0.1.0",
  "identifier": "io.github.akseleron.kd3b-control",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
